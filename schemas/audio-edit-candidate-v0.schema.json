{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/audio-edit-candidate-v0.schema.json",
  "title": "MUSICA Audio Edit Candidate v0",
  "description": "Non-canonical source-bound proposal for native audio track/clip material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_version", "candidate_id", "authority_target", "source", "actor", "reason", "operations", "preview_only"],
  "properties": {
    "candidate_version": {"const": "0"},
    "candidate_id": {"$ref": "#/$defs/stableId"},
    "authority_target": {"const": "blueprint_audio_material"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256", "audio_material_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audio_material_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id"],
      "properties": {
        "kind": {"enum": ["user", "ai", "import", "system"]},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/operation"}
    },
    "preview_only": {"const": true}
  },
  "$defs": {
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "assetId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gainDb": {"type": "number", "minimum": -60.0, "maximum": 12.0},
    "trackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id"],
      "properties": {"track_id": {"$ref": "#/$defs/stableId"}}
    },
    "clipTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "clip_id"],
      "properties": {
        "track_id": {"$ref": "#/$defs/stableId"},
        "clip_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "clipValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "asset_id", "timeline_start_seconds", "source_in_seconds", "source_out_seconds", "gain_db"],
      "properties": {
        "clip_id": {"$ref": "#/$defs/stableId"},
        "asset_id": {"$ref": "#/$defs/assetId"},
        "timeline_start_seconds": {"type": "number", "minimum": 0},
        "source_in_seconds": {"type": "number", "minimum": 0},
        "source_out_seconds": {"type": "number", "exclusiveMinimum": 0},
        "gain_db": {"$ref": "#/$defs/gainDb"}
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "track_id", "order", "name"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "ADD_TRACK"},
            "track_id": {"$ref": "#/$defs/stableId"},
            "order": {"type": "integer", "minimum": 0},
            "name": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "clip"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "ADD_CLIP"},
            "target": {"$ref": "#/$defs/trackTarget"},
            "clip": {"$ref": "#/$defs/clipValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "timeline_start_seconds"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "MOVE_CLIP"},
            "target": {"$ref": "#/$defs/clipTarget"},
            "timeline_start_seconds": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "source_in_seconds", "source_out_seconds"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "TRIM_CLIP"},
            "target": {"$ref": "#/$defs/clipTarget"},
            "source_in_seconds": {"type": "number", "minimum": 0},
            "source_out_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "gain_db"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "SET_CLIP_GAIN"},
            "target": {"$ref": "#/$defs/clipTarget"},
            "gain_db": {"$ref": "#/$defs/gainDb"}
          }
        }
      ]
    }
  }
}
