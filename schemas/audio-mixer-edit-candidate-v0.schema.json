{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/audio-mixer-edit-candidate-v0.schema.json",
  "title": "MUSICA Audio Mixer Edit Candidate v0",
  "description": "ATCM-R2 source-bound extension of the R1 audio Preview/Accept authority family.",
  "type":"object","additionalProperties":false,
  "required":["candidate_version","candidate_id","authority_target","source","actor","reason","operations","preview_only"],
  "properties":{
    "candidate_version":{"const":"0"},
    "candidate_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "authority_target":{"const":"blueprint_audio_material"},
    "source":{"type":"object","additionalProperties":false,"required":["project_id","revision_id","blueprint_sha256","audio_material_sha256"],"properties":{"project_id":{"type":"string","minLength":1,"maxLength":128},"revision_id":{"type":"string","minLength":1,"maxLength":128},"blueprint_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"audio_material_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "actor":{"type":"object","additionalProperties":false,"required":["kind","actor_id"],"properties":{"kind":{"enum":["user","ai","import","system"]},"actor_id":{"type":"string","minLength":1,"maxLength":128}}},
    "reason":{"type":"string","minLength":1,"maxLength":1000},
    "operations":{"type":"array","minItems":1,"maxItems":1024,"items":{"type":"object","additionalProperties":false,"required":["operation_id","op","target","mixer"],"properties":{"operation_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},"op":{"const":"SET_TRACK_MIXER"},"target":{"type":"object","additionalProperties":false,"required":["track_id"],"properties":{"track_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"}}},"mixer":{"type":"object","additionalProperties":false,"required":["gain_db","pan","mute","solo"],"properties":{"gain_db":{"type":"number","minimum":-60,"maximum":12},"pan":{"type":"number","minimum":-1,"maximum":1},"mute":{"type":"boolean"},"solo":{"type":"boolean"}}}}}},
    "preview_only":{"const":true}
  }
}
