{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/automation-execution-v0.schema.json",
  "title": "MUSICA Automation Execution v0",
  "description": "Deterministic, source-bound, backend-independent derived automation execution package. This object is non-canonical and grants no reverse or project mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_version", "classification", "source", "lowering", "authority", "lanes", "unsupported"],
  "properties": {
    "execution_version": {"const": "0"},
    "classification": {"const": "derived_noncanonical"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256", "automation_material_sha256", "explicit_automation_present"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "blueprint_sha256": {"$ref": "#/$defs/sha256"},
        "automation_material_sha256": {"$ref": "#/$defs/sha256"},
        "explicit_automation_present": {"type": "boolean"}
      }
    },
    "lowering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_id", "compiler_version", "policy_id", "ppq", "tick_rounding"],
      "properties": {
        "compiler_id": {"const": "musica-automation-lowering"},
        "compiler_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "policy_id": {"const": "automation-execution-v0-generic-segments"},
        "ppq": {"type": "integer", "const": 480},
        "tick_rounding": {"const": "decimal_nearest_half_up_nonnegative"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "project_mutation_authorized", "blueprint_mutation_authorized", "reverse_promotion_authorized", "renderer_mapping_authorized", "audible_automation_validated"],
      "properties": {
        "canonical": {"const": false},
        "project_mutation_authorized": {"const": false},
        "blueprint_mutation_authorized": {"const": false},
        "reverse_promotion_authorized": {"const": false},
        "renderer_mapping_authorized": {"const": false},
        "audible_automation_validated": {"const": false}
      }
    },
    "lanes": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/lane"}
    },
    "unsupported": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/unsupported"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "beat", "tick", "value", "interpolation"],
      "properties": {
        "point_id": {"$ref": "#/$defs/stableId"},
        "beat": {"type": "number", "minimum": 0, "maximum": 1000000},
        "tick": {"type": "integer", "minimum": 0},
        "value": {"type": "number"},
        "interpolation": {"enum": ["hold", "linear"]}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_point_id", "end_point_id", "start_tick", "end_tick", "start_value", "end_value", "interpolation"],
      "properties": {
        "start_point_id": {"$ref": "#/$defs/stableId"},
        "end_point_id": {"$ref": "#/$defs/stableId"},
        "start_tick": {"type": "integer", "minimum": 0},
        "end_tick": {"type": "integer", "minimum": 0},
        "start_value": {"type": "number"},
        "end_value": {"type": "number"},
        "interpolation": {"enum": ["hold", "linear"]}
      }
    },
    "backendMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"const": "UNMAPPED"}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "parameter_id", "scope", "owner_id", "section_id", "unit", "minimum", "maximum", "derivation_status", "backend_mapping", "points", "segments"],
      "properties": {
        "lane_id": {"$ref": "#/$defs/stableId"},
        "parameter_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
        },
        "scope": {"enum": ["project", "part", "audio_track", "routing_node"]},
        "owner_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "section_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "unit": {"enum": ["normalized", "decibel", "hertz", "semitone", "ratio"]},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "derivation_status": {"const": "DERIVED_GENERIC"},
        "backend_mapping": {"$ref": "#/$defs/backendMapping"},
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/point"}
        },
        "segments": {
          "type": "array",
          "maxItems": 99999,
          "items": {"$ref": "#/$defs/segment"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "project"}}, "required": ["scope"]},
          "then": {"properties": {"owner_id": {"const": null}}}
        },
        {
          "if": {"properties": {"scope": {"const": "part"}}, "required": ["scope"]},
          "then": {"properties": {"owner_id": {"type": "string", "minLength": 1, "maxLength": 128}}}
        },
        {
          "if": {"properties": {"scope": {"enum": ["audio_track", "routing_node"]}}, "required": ["scope"]},
          "then": {"properties": {"owner_id": {"type": "string", "minLength": 1, "maxLength": 128}}}
        }
      ]
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "lane_id", "reason"],
      "properties": {
        "code": {"enum": ["UNSUPPORTED_SCOPE", "UNSUPPORTED_UNIT", "UNSUPPORTED_PARAMETER", "INVALID_SOURCE"]},
        "lane_id": {"type": ["string", "null"], "maxLength": 128},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
