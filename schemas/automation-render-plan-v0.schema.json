{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/automation-render-plan-v0.schema.json",
  "title": "MUSICA Automation Render Plan v0",
  "description": "Renderer-specific, source-hash-bound, derived/non-canonical automation plan for the bounded M7-R4 reference-renderer mix.gain mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "classification", "source", "renderer", "mapping", "authority", "mapped_lanes", "unmapped_lanes"],
  "properties": {
    "plan_version": {"const": "0"},
    "classification": {"const": "derived_noncanonical"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "music_ir_sha256", "automation_execution_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "music_ir_sha256": {"$ref": "#/$defs/sha256"},
        "automation_execution_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_id", "renderer_version"],
      "properties": {
        "renderer_id": {"const": "musica-reference-local"},
        "renderer_version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "application_stage", "time_domain", "output"],
      "properties": {
        "policy_id": {"const": "reference-renderer-mix-gain-v0"},
        "policy_version": {"const": "0.1.0"},
        "application_stage": {"const": "post_synthesis_post_safety_normalization"},
        "time_domain": {"const": "music_ir_tick"},
        "output": {"const": "wav_pcm_gain"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "project_mutation_authorized", "blueprint_mutation_authorized", "reverse_promotion_authorized", "midi_cc_semantics_authorized", "renderer_application_authorized", "audible_automation_evidence_required"],
      "properties": {
        "canonical": {"const": false},
        "project_mutation_authorized": {"const": false},
        "blueprint_mutation_authorized": {"const": false},
        "reverse_promotion_authorized": {"const": false},
        "midi_cc_semantics_authorized": {"const": false},
        "renderer_application_authorized": {"const": true},
        "audible_automation_evidence_required": {"const": true}
      }
    },
    "mapped_lanes": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/mappedLane"}
    },
    "unmapped_lanes": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/unmappedLane"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point_id", "tick", "value", "interpolation"],
      "properties": {
        "point_id": {"$ref": "#/$defs/stableId"},
        "tick": {"type": "integer", "minimum": 0},
        "value": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "interpolation": {"enum": ["hold", "linear"]}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_point_id", "end_point_id", "start_tick", "end_tick", "start_value", "end_value", "interpolation"],
      "properties": {
        "start_point_id": {"$ref": "#/$defs/stableId"},
        "end_point_id": {"$ref": "#/$defs/stableId"},
        "start_tick": {"type": "integer", "minimum": 0},
        "end_tick": {"type": "integer", "minimum": 0},
        "start_value": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "end_value": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "interpolation": {"enum": ["hold", "linear"]}
      }
    },
    "mappedLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "parameter_id", "scope", "owner_id", "section_id", "unit", "minimum", "maximum", "mapping_id", "application", "points", "segments"],
      "properties": {
        "lane_id": {"$ref": "#/$defs/stableId"},
        "parameter_id": {"const": "mix.gain"},
        "scope": {"const": "project"},
        "owner_id": {"const": null},
        "section_id": {"const": null},
        "unit": {"const": "normalized"},
        "minimum": {"const": 0.0},
        "maximum": {"const": 1.0},
        "mapping_id": {"const": "reference.mix_gain.normalized"},
        "application": {"const": "post_normalization_pcm_gain"},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
      }
    },
    "unmappedLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "parameter_id", "scope", "unit", "code", "reason"],
      "properties": {
        "lane_id": {"$ref": "#/$defs/stableId"},
        "parameter_id": {"type": "string", "minLength": 3, "maxLength": 160},
        "scope": {"enum": ["project", "part"]},
        "unit": {"enum": ["normalized", "decibel", "hertz", "semitone", "ratio"]},
        "code": {"enum": ["UNSUPPORTED_PARAMETER", "UNSUPPORTED_SCOPE", "UNSUPPORTED_UNIT", "UNSUPPORTED_RANGE", "SECTION_SCOPED_UNSUPPORTED"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  }
}
