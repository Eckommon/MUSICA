{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/director-provider-v0.schema.json",
  "title": "MUSICA Director Provider Capability v0",
  "description": "Provider capability declaration / Provider 역량 선언",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_version", "provider_id", "provider_version", "model_id",
    "deterministic", "network_required", "supported_modes",
    "supported_style_profiles", "supported_semantic_axes", "claim_boundary"
  ],
  "properties": {
    "capability_version": {"const": "0"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "deterministic": {"type": "boolean"},
    "network_required": {"type": "boolean"},
    "supported_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["create", "edit"]}
    },
    "supported_style_profiles": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["dark_electronic", "warm_ambient", "kinetic_minimal"]}
    },
    "supported_semantic_axes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["energy", "tension", "density", "motion", "brightness", "warmth"]}
    },
    "claim_boundary": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
