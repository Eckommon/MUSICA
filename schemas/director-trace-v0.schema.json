{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/director-trace-v0.schema.json",
  "title": "MUSICA Director Trace v0",
  "description": "Evidence linking a non-authoritative provider proposal to the trusted MUSICA contract accepted for downstream processing / 비권위 provider 제안과 downstream 처리용 신뢰 MUSICA 계약을 연결하는 근거",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version", "request_id", "proposal_id", "mode", "provider_id", "provider_version", "model_id",
    "request_sha256", "proposal_sha256", "provider_capabilities_sha256",
    "accepted_contract_kind", "accepted_contract_sha256", "authority_status", "warnings"
  ],
  "properties": {
    "trace_version": {"const": "0"},
    "request_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["create", "edit"]},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_capabilities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_contract_kind": {"enum": ["music_intent_v0", "semantic_control_v0"]},
    "accepted_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_status": {"const": "PROPOSAL_ONLY_MUSICA_CORE_ACCEPTED"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
