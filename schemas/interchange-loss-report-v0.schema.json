{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/interchange-loss-report-v0.schema.json",
  "title": "MUSICA Interchange Loss Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "source_revision_id",
    "source_blueprint_sha256",
    "source_music_ir_sha256",
    "source_artifact_sha256",
    "normalization_policy",
    "classifications"
  ],
  "properties": {
    "report_version": {"const": "0"},
    "source_revision_id": {"type": "string", "minLength": 1},
    "source_blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_music_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalization_policy": {"type": "string", "minLength": 1},
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic", "state", "reason"],
        "properties": {
          "semantic": {"type": "string", "minLength": 1},
          "state": {"enum": ["PRESERVED", "TRANSFORMED", "DROPPED", "UNSUPPORTED", "UNKNOWN"]},
          "reason": {"type": "string", "minLength": 1},
          "conversion_policy": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
