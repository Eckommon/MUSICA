{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/interchange-note-receipt-v0.schema.json",
  "title": "MUSICA Interchange Note Receipt v0",
  "description": "Hash-bound receipt that connects one accepted exact-note Blueprint revision to one deterministic MUSICA-origin DAWproject export and its stable-note identity map. The receipt is evidence, not project authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_version",
    "source",
    "export",
    "scope",
    "note_identity_map",
    "identity_map_sha256"
  ],
  "properties": {
    "receipt_version": {"const": "0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "format_version",
        "artifact_sha256",
        "normalized_sha256",
        "normalization_policy"
      ],
      "properties": {
        "format": {"const": "DAWproject"},
        "format_version": {"const": "1.0"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "normalization_policy": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "part_id", "channel", "single_primitive_only"],
      "properties": {
        "track_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "part_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "channel": {"type": "integer", "minimum": 0, "maximum": 15},
        "single_primitive_only": {"const": true}
      }
    },
    "note_identity_map": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note_id", "part_id", "track_id", "signature"],
        "properties": {
          "note_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "part_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "track_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "signature": {"$ref": "#/$defs/signature"}
        }
      }
    },
    "identity_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "duration", "pitch", "velocity", "channel"],
      "properties": {
        "tick": {"type": "integer", "minimum": 0},
        "duration": {"type": "integer", "minimum": 1},
        "pitch": {"type": "integer", "minimum": 0, "maximum": 127},
        "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
        "channel": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    }
  }
}
