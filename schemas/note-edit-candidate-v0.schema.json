{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/note-edit-candidate-v0.schema.json",
  "title": "MUSICA Note Edit Candidate v0",
  "description": "Non-canonical exact-note edit proposal bound to one accepted Blueprint source revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_version",
    "candidate_id",
    "authority_target",
    "source",
    "actor",
    "reason",
    "operations",
    "preview_only"
  ],
  "properties": {
    "candidate_version": {"const": "0"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "authority_target": {"const": "blueprint_exact_note_material"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "blueprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["user", "ai", "import", "deterministic_transform"]},
        "actor_id": {"type": ["string", "null"], "maxLength": 256}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 2048},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/operation"}
    },
    "preview_only": {"const": true}
  },
  "$defs": {
    "noteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "partId": {"type": "string", "minLength": 1, "maxLength": 128},
    "exactNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note_id",
        "part_id",
        "section_id",
        "start_beat",
        "duration_beats",
        "pitch",
        "velocity"
      ],
      "properties": {
        "note_id": {"$ref": "#/$defs/noteId"},
        "part_id": {"$ref": "#/$defs/partId"},
        "section_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "start_beat": {"type": "number", "minimum": 0, "maximum": 1000000},
        "duration_beats": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000},
        "pitch": {"type": "integer", "minimum": 0, "maximum": 127},
        "velocity": {"type": "integer", "minimum": 1, "maximum": 127},
        "articulation": {"enum": ["normal", "legato", "staccato", "tenuto", "accent"]},
        "identity_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_id", "part_id"],
      "properties": {
        "note_id": {"$ref": "#/$defs/noteId"},
        "part_id": {"$ref": "#/$defs/partId"}
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "note"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "INSERT"},
            "note": {"$ref": "#/$defs/exactNote"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "DELETE"},
            "target": {"$ref": "#/$defs/target"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "start_beat"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "MOVE"},
            "target": {"$ref": "#/$defs/target"},
            "start_beat": {"type": "number", "minimum": 0, "maximum": 1000000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "duration_beats"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "RESIZE"},
            "target": {"$ref": "#/$defs/target"},
            "duration_beats": {"type": "number", "exclusiveMinimum": 0, "maximum": 100000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "pitch"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "REPITCH"},
            "target": {"$ref": "#/$defs/target"},
            "pitch": {"type": "integer", "minimum": 0, "maximum": 127}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "target", "velocity"],
          "properties": {
            "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "op": {"const": "SET_VELOCITY"},
            "target": {"$ref": "#/$defs/target"},
            "velocity": {"type": "integer", "minimum": 1, "maximum": 127}
          }
        }
      ]
    }
  }
}
