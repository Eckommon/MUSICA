{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/openai-adapter-exchange-v0.schema.json",
  "title": "MUSICA OpenAI Adapter Exchange v0",
  "description": "Secret-free provenance for one OpenAI Responses adapter exchange / OpenAI Responses adapter 1회 교환의 secret-free provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange_version", "evidence_class", "api_family", "endpoint",
    "provider_id", "provider_version", "requested_model_id", "response_model_id",
    "response_id", "response_status", "request_payload_sha256", "raw_response_sha256",
    "structured_body_sha256", "director_proposal_sha256", "usage",
    "network_used", "credential_source", "secret_recorded"
  ],
  "properties": {
    "exchange_version": {"const": "0"},
    "evidence_class": {"enum": ["ADAPTER_CONTRACT_EVIDENCE", "LIVE_PROVIDER_EVIDENCE"]},
    "api_family": {"const": "openai-responses"},
    "endpoint": {"const": "https://api.openai.com/v1/responses"},
    "provider_id": {"const": "openai-responses-api"},
    "provider_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "requested_model_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "response_model_id": {"type": ["string", "null"], "maxLength": 200},
    "response_id": {"type": ["string", "null"], "maxLength": 200},
    "response_status": {"type": "string", "minLength": 1, "maxLength": 80},
    "request_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structured_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "director_proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "network_used": {"type": "boolean"},
    "credential_source": {"enum": ["OPENAI_API_KEY environment", "injected-no-secret"]},
    "secret_recorded": {"const": false}
  }
}
