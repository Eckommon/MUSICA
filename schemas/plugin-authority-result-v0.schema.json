{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/plugin-authority-result-v0.schema.json",
  "title": "MUSICA Plugin Authority Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "candidate_id", "status", "conflicts", "preview_generation_allowed", "explicit_accept_required", "project_mutation_authorized", "render_mutation_authorized"],
  "properties": {
    "result_version": {"const": "0"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "status": {"enum": ["READY_FOR_PREVIEW", "BLOCKED"]},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "code", "reason"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "code": {"enum": ["STALE_SOURCE", "UNREPRESENTABLE_EDIT", "INVALID_TARGET", "REVISION_CONFLICT"]},
          "reason": {"type": "string", "minLength": 1},
          "instance_id": {"type": "string", "minLength": 1},
          "plugin_id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "preview_generation_allowed": {"type": "boolean"},
    "explicit_accept_required": {"const": true},
    "project_mutation_authorized": {"const": false},
    "render_mutation_authorized": {"const": false}
  }
}
