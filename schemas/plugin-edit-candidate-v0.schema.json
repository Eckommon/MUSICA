{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/plugin-edit-candidate-v0.schema.json",
  "title": "MUSICA Plugin Edit Candidate v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_version", "candidate_id", "authority_target", "source", "actor", "reason", "operations", "preview_only"],
  "properties": {
    "candidate_version": {"const": "0"},
    "candidate_id": {"$ref": "#/$defs/stableId"},
    "authority_target": {"const": "blueprint_plugin_material"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256", "audio_material_sha256", "routing_material_sha256", "automation_material_sha256", "plugin_material_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "blueprint_sha256": {"$ref": "#/$defs/sha256"},
        "audio_material_sha256": {"$ref": "#/$defs/sha256"},
        "routing_material_sha256": {"$ref": "#/$defs/sha256"},
        "automation_material_sha256": {"$ref": "#/$defs/sha256"},
        "plugin_material_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id"],
      "properties": {
        "kind": {"enum": ["user", "ai", "system"]},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 1024},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/operation"}
    },
    "preview_only": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "format", "vendor", "name", "version", "processor_id", "io", "latency", "parameters"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/stableId"},
        "format": {"const": "simulated_reference_v0"},
        "vendor": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "processor_id": {"const": "musica-simulated-gain-delay-v0"},
        "io": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_channels", "output_channels", "sample_format", "sample_rate_policy"],
          "properties": {
            "input_channels": {"const": 2},
            "output_channels": {"const": 2},
            "sample_format": {"const": "float64"},
            "sample_rate_policy": {"const": "exact_match_required_no_resampling"}
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "parameter_id", "unit"],
          "properties": {
            "mode": {"const": "state_parameter"},
            "parameter_id": {"const": "delay_frames"},
            "unit": {"const": "frames"}
          }
        },
        "parameters": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter_id", "unit", "minimum", "maximum", "default"],
            "properties": {
              "parameter_id": {"enum": ["gain_db", "delay_frames"]},
              "unit": {"enum": ["decibel", "frames"]},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "default": {"type": "number"}
            }
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "plugin_id", "owner", "slot", "bypass", "state"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/stableId"},
        "plugin_id": {"$ref": "#/$defs/stableId"},
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner_id"],
          "properties": {
            "kind": {"const": "routing_node"},
            "owner_id": {"$ref": "#/$defs/stableId"}
          }
        },
        "slot": {"type": "integer", "minimum": 0, "maximum": 255},
        "bypass": {"type": "boolean"},
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gain_db", "delay_frames"],
          "properties": {
            "gain_db": {"type": "number", "minimum": -60.0, "maximum": 12.0},
            "delay_frames": {"type": "integer", "minimum": 0, "maximum": 4096}
          }
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "descriptor", "instance"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "ADD_INSTANCE"},
            "descriptor": {"$ref": "#/$defs/descriptor"},
            "instance": {"$ref": "#/$defs/instance"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "instance_id"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "REMOVE_INSTANCE"},
            "instance_id": {"$ref": "#/$defs/stableId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "instance_id", "state"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "SET_STATE"},
            "instance_id": {"$ref": "#/$defs/stableId"},
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gain_db", "delay_frames"],
              "properties": {
                "gain_db": {"type": "number", "minimum": -60.0, "maximum": 12.0},
                "delay_frames": {"type": "integer", "minimum": 0, "maximum": 4096}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "op", "instance_id", "bypass"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/stableId"},
            "op": {"const": "SET_BYPASS"},
            "instance_id": {"$ref": "#/$defs/stableId"},
            "bypass": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
