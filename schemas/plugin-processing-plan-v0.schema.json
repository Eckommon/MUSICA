{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/plugin-processing-plan-v0.schema.json",
  "title": "MUSICA Simulated Plugin Processing Plan v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "engine_id", "classification", "source", "sample_rate_hz", "channels", "sample_format", "policy", "instances", "total_effective_latency_frames", "plugin_processing_plan_sha256"],
  "properties": {
    "plan_version": {"const": "0"},
    "engine_id": {"const": "musica-simulated-plugin-processor-v0"},
    "classification": {"const": "derived_noncanonical"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id", "blueprint_sha256", "audio_material_sha256", "routing_material_sha256", "automation_material_sha256", "routed_mix_plan_sha256", "routed_wav_sha256", "plugin_material_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "blueprint_sha256": {"$ref": "#/$defs/sha256"},
        "audio_material_sha256": {"$ref": "#/$defs/sha256"},
        "routing_material_sha256": {"$ref": "#/$defs/sha256"},
        "automation_material_sha256": {"$ref": "#/$defs/sha256"},
        "routed_mix_plan_sha256": {"$ref": "#/$defs/sha256"},
        "routed_wav_sha256": {"$ref": "#/$defs/sha256"},
        "plugin_material_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000},
    "channels": {"const": 2},
    "sample_format": {"const": "float64_internal_pcm16_io"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insertion_point", "ordering", "latency", "resampling", "channel_conversion", "output_clipping"],
      "properties": {
        "insertion_point": {"const": "post_routed_master_pcm16_reference_stage"},
        "ordering": {"const": "slot_then_instance_id"},
        "latency": {"const": "serial_sum_of_nonbypassed_fixed_delay_frames"},
        "resampling": {"const": "forbidden"},
        "channel_conversion": {"const": "forbidden_stereo_only"},
        "output_clipping": {"const": "hard_clip_unit_range_before_pcm16"}
      }
    },
    "instances": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "plugin_id", "owner_node_id", "slot", "bypass", "processor_id", "gain_db", "gain_linear", "delay_frames", "effective_latency_frames"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "plugin_id": {"type": "string", "minLength": 1},
          "owner_node_id": {"type": "string", "minLength": 1},
          "slot": {"type": "integer", "minimum": 0},
          "bypass": {"type": "boolean"},
          "processor_id": {"const": "musica-simulated-gain-delay-v0"},
          "gain_db": {"type": "number"},
          "gain_linear": {"type": "number", "minimum": 0},
          "delay_frames": {"type": "integer", "minimum": 0},
          "effective_latency_frames": {"type": "integer", "minimum": 0}
        }
      }
    },
    "total_effective_latency_frames": {"type": "integer", "minimum": 0},
    "plugin_processing_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
