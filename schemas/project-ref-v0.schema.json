{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/project-ref-v0.schema.json",
  "title": "MUSICA Project Ref v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref_version", "ref_name", "revision_id", "revision_record_sha256"],
  "properties": {
    "ref_version": {"const": "0"},
    "ref_name": {"type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "revision_id": {"type": "string", "minLength": 1},
    "revision_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
