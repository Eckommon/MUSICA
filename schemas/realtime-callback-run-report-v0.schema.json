{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/realtime-callback-run-report-v0.schema.json",
  "title":"MUSICA Realtime Callback Run Report v0",
  "type":"object",
  "additionalProperties":false,
  "required":["report_version","classification","source","adapter","lifecycle","completion_status","metrics","sink","accepted_head_unchanged","runtime_state_is_canonical","callback_run_report_sha256"],
  "properties":{
    "report_version":{"const":"0"},
    "classification":{"const":"derived_noncanonical"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["revision_id","realtime_execution_plan_sha256"],
      "properties":{
        "revision_id":{"type":"string","minLength":1},
        "realtime_execution_plan_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "adapter":{
      "type":"object","additionalProperties":false,
      "required":["adapter_id","capability_sha256"],
      "properties":{
        "adapter_id":{"const":"musica-deterministic-callback-adapter-v0"},
        "capability_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "lifecycle":{
      "type":"array","minItems":6,
      "items":{"enum":["CLOSED","OPEN","CALLBACK_REGISTERED","RUNNING","STOPPED"]}
    },
    "completion_status":{"enum":["END_OF_STREAM","STOPPED_EARLY"]},
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["callbacks_requested","callbacks_completed","frames_requested","frames_delivered","final_frame_cursor","error_count","short_fill_count","late_count","xrun_equivalent_count"],
      "properties":{
        "callbacks_requested":{"type":"integer","minimum":0},
        "callbacks_completed":{"type":"integer","minimum":0},
        "frames_requested":{"type":"integer","minimum":0},
        "frames_delivered":{"type":"integer","minimum":0},
        "final_frame_cursor":{"type":"integer","minimum":0},
        "error_count":{"type":"integer","minimum":0},
        "short_fill_count":{"type":"integer","minimum":0},
        "late_count":{"type":"integer","minimum":0},
        "xrun_equivalent_count":{"type":"integer","minimum":0}
      }
    },
    "sink":{
      "type":"object","additionalProperties":false,
      "required":["format","payload_sha256","payload_size_bytes","frame_count"],
      "properties":{
        "format":{"const":"pcm16_stereo_little_endian_payload"},
        "payload_sha256":{"$ref":"#/$defs/sha256"},
        "payload_size_bytes":{"type":"integer","minimum":0},
        "frame_count":{"type":"integer","minimum":0}
      }
    },
    "accepted_head_unchanged":{"const":true},
    "runtime_state_is_canonical":{"const":false},
    "callback_run_report_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
