{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/realtime-execution-plan-v0.schema.json",
  "title":"MUSICA Realtime Execution Plan v0",
  "type":"object",
  "additionalProperties":false,
  "required":["plan_version","engine_id","classification","source","backend","sample_rate_hz","output_channels","block_size_frames","duration_frames","transport","policy","realtime_execution_plan_sha256"],
  "properties":{
    "plan_version":{"const":"0"},
    "engine_id":{"const":"musica-realtime-simulated-engine-v0"},
    "classification":{"const":"derived_noncanonical"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["project_id","revision_id","blueprint_sha256","audio_material_sha256","routing_material_sha256","automation_material_sha256","routed_mix_plan_sha256","routed_wav_sha256"],
      "properties":{
        "project_id":{"type":"string","minLength":1},
        "revision_id":{"type":"string","minLength":1},
        "blueprint_sha256":{"$ref":"#/$defs/sha256"},
        "audio_material_sha256":{"$ref":"#/$defs/sha256"},
        "routing_material_sha256":{"$ref":"#/$defs/sha256"},
        "automation_material_sha256":{"$ref":"#/$defs/sha256"},
        "routed_mix_plan_sha256":{"$ref":"#/$defs/sha256"},
        "routed_wav_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "backend":{
      "type":"object","additionalProperties":false,
      "required":["backend_id","classification","capability_sha256","nominal_output_latency_frames"],
      "properties":{
        "backend_id":{"const":"musica-simulated-output-v0"},
        "classification":{"const":"simulated_test_backend"},
        "capability_sha256":{"$ref":"#/$defs/sha256"},
        "nominal_output_latency_frames":{"type":"integer","minimum":0}
      }
    },
    "sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},
    "output_channels":{"const":2},
    "block_size_frames":{"type":"integer","minimum":1,"maximum":8192},
    "duration_frames":{"type":"integer","minimum":1},
    "transport":{
      "type":"object","additionalProperties":false,
      "required":["start_frame","end_frame_exclusive"],
      "properties":{
        "start_frame":{"const":0},
        "end_frame_exclusive":{"type":"integer","minimum":1}
      }
    },
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["source_rate_policy","source_format","scheduler","final_block","wall_clock_authority","runtime_state_is_canonical"],
      "properties":{
        "source_rate_policy":{"const":"exact_match_required_no_resampling"},
        "source_format":{"const":"routed_wav_pcm16_stereo_little_endian"},
        "scheduler":{"const":"sequential_fixed_blocks_from_zero_based_frame_cursor"},
        "final_block":{"const":"partial_block_without_padding"},
        "wall_clock_authority":{"const":"none_simulated"},
        "runtime_state_is_canonical":{"const":false}
      }
    },
    "realtime_execution_plan_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
