{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/realtime-run-report-v0.schema.json",
  "title":"MUSICA Realtime Run Report v0",
  "type":"object",
  "additionalProperties":false,
  "required":["report_version","classification","source","lifecycle","metrics","sink","accepted_head_unchanged","runtime_state_is_canonical","realtime_run_report_sha256"],
  "properties":{
    "report_version":{"const":"0"},
    "classification":{"const":"derived_noncanonical"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["revision_id","realtime_execution_plan_sha256"],
      "properties":{
        "revision_id":{"type":"string","minLength":1},
        "realtime_execution_plan_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "lifecycle":{
      "type":"array","minItems":5,
      "items":{"enum":["CLOSED","OPEN","RUNNING","STOPPED"]}
    },
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["blocks_requested","blocks_written","frames_requested","frames_written","final_frame_cursor","xrun_count","nominal_output_latency_frames"],
      "properties":{
        "blocks_requested":{"type":"integer","minimum":0},
        "blocks_written":{"type":"integer","minimum":0},
        "frames_requested":{"type":"integer","minimum":0},
        "frames_written":{"type":"integer","minimum":0},
        "final_frame_cursor":{"type":"integer","minimum":0},
        "xrun_count":{"type":"integer","minimum":0},
        "nominal_output_latency_frames":{"type":"integer","minimum":0}
      }
    },
    "sink":{
      "type":"object","additionalProperties":false,
      "required":["format","payload_sha256","payload_size_bytes","frame_count"],
      "properties":{
        "format":{"const":"pcm16_stereo_little_endian_payload"},
        "payload_sha256":{"$ref":"#/$defs/sha256"},
        "payload_size_bytes":{"type":"integer","minimum":0},
        "frame_count":{"type":"integer","minimum":0}
      }
    },
    "accepted_head_unchanged":{"const":true},
    "runtime_state_is_canonical":{"const":false},
    "realtime_run_report_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
