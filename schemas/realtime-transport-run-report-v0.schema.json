{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/realtime-transport-run-report-v0.schema.json",
  "title":"MUSICA Realtime Transport Run Report v0",
  "type":"object","additionalProperties":false,
  "required":["report_version","classification","source","transport_policy","latency","metrics","sink","accepted_head_unchanged","runtime_state_is_canonical","transport_run_report_sha256"],
  "properties":{
    "report_version":{"const":"0"},
    "classification":{"const":"derived_noncanonical"},
    "source":{"type":"object","additionalProperties":false,"required":["revision_id","realtime_execution_plan_sha256"],"properties":{
      "revision_id":{"type":"string","minLength":1},
      "realtime_execution_plan_sha256":{"$ref":"#/$defs/sha256"}
    }},
    "transport_policy":{"type":"object","additionalProperties":false,"required":["seek_while_playing","callback_index_policy","position_authority","eos_policy"],"properties":{
      "seek_while_playing":{"const":"fail_closed"},
      "callback_index_policy":{"const":"reset_to_zero_per_play_segment"},
      "position_authority":{"const":"exact_frame_cursor_not_wall_clock"},
      "eos_policy":{"const":"terminal_until_seek"}
    }},
    "latency":{"type":"object","additionalProperties":false,"required":["configured_block_size_frames","nominal_output_latency_frames","nominal_source","host_observed_latency_available","wall_clock_guarantee_claimed"],"properties":{
      "configured_block_size_frames":{"type":"integer","minimum":1},
      "nominal_output_latency_frames":{"type":"integer","minimum":0},
      "nominal_source":{"const":"simulated_backend_capability"},
      "host_observed_latency_available":{"const":false},
      "wall_clock_guarantee_claimed":{"const":false}
    }},
    "metrics":{"type":"object","additionalProperties":false,"required":["play_count","stop_count","seek_count","transport_discontinuity_count","callbacks_requested","frames_requested","frames_delivered","error_count","short_fill_count","late_count","xrun_dropout_equivalent_count","final_playhead_frame","final_callback_cursor","final_state"],"properties":{
      "play_count":{"type":"integer","minimum":0},
      "stop_count":{"type":"integer","minimum":0},
      "seek_count":{"type":"integer","minimum":0},
      "transport_discontinuity_count":{"type":"integer","minimum":0},
      "callbacks_requested":{"type":"integer","minimum":0},
      "frames_requested":{"type":"integer","minimum":0},
      "frames_delivered":{"type":"integer","minimum":0},
      "error_count":{"type":"integer","minimum":0},
      "short_fill_count":{"type":"integer","minimum":0},
      "late_count":{"type":"integer","minimum":0},
      "xrun_dropout_equivalent_count":{"type":"integer","minimum":0},
      "final_playhead_frame":{"type":"integer","minimum":0},
      "final_callback_cursor":{"type":"integer","minimum":0},
      "final_state":{"enum":["STOPPED","PLAYING","END_OF_STREAM"]}
    }},
    "sink":{"type":"object","additionalProperties":false,"required":["format","payload_sha256","payload_size_bytes","frame_count"],"properties":{
      "format":{"const":"pcm16_stereo_little_endian_payload"},
      "payload_sha256":{"$ref":"#/$defs/sha256"},
      "payload_size_bytes":{"type":"integer","minimum":0},
      "frame_count":{"type":"integer","minimum":0}
    }},
    "accepted_head_unchanged":{"const":true},
    "runtime_state_is_canonical":{"const":false},
    "transport_run_report_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}