{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/recording-capture-run-report-v0.schema.json",
  "title":"MUSICA Recording Capture Run Report v0",
  "type":"object","additionalProperties":false,
  "required":["report_version","classification","source","lifecycle","metrics","payload","accepted_head_unchanged","runtime_state_is_canonical","captured_payload_is_canonical","recording_capture_run_report_sha256"],
  "properties":{
    "report_version":{"const":"0"},"classification":{"const":"derived_noncanonical"},
    "source":{"type":"object","additionalProperties":false,"required":["revision_id","recording_capture_plan_sha256"],"properties":{"revision_id":{"type":"string","minLength":1},"recording_capture_plan_sha256":{"$ref":"#/$defs/sha256"}}},
    "lifecycle":{"type":"array","minItems":1,"items":{"enum":["CLOSED","OPEN","READY","CAPTURING","STOPPED","FINALIZED"]}},
    "metrics":{"type":"object","additionalProperties":false,"required":["blocks_requested","blocks_captured","frames_requested","frames_captured","final_capture_cursor","error_count","short_fill_count","late_count","dropout_equivalent_count"],"properties":{
      "blocks_requested":{"type":"integer","minimum":0},"blocks_captured":{"type":"integer","minimum":0},"frames_requested":{"type":"integer","minimum":0},"frames_captured":{"type":"integer","minimum":0},"final_capture_cursor":{"type":"integer","minimum":0},
      "error_count":{"type":"integer","minimum":0},"short_fill_count":{"type":"integer","minimum":0},"late_count":{"type":"integer","minimum":0},"dropout_equivalent_count":{"type":"integer","minimum":0}
    }},
    "payload":{"type":"object","additionalProperties":false,"required":["format","channels","sample_rate_hz","payload_sha256","payload_size_bytes","captured_frames"],"properties":{
      "format":{"const":"pcm16_little_endian"},"channels":{"enum":[1,2]},"sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},"payload_sha256":{"$ref":"#/$defs/sha256"},"payload_size_bytes":{"type":"integer","minimum":0},"captured_frames":{"type":"integer","minimum":0}
    }},
    "accepted_head_unchanged":{"const":true},"runtime_state_is_canonical":{"const":false},"captured_payload_is_canonical":{"const":false},
    "recording_capture_run_report_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
