{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/recording-finalize-authority-result-v0.schema.json",
  "title":"MUSICA Recording Finalize Authority Result v0",
  "type":"object","additionalProperties":false,
  "required":["result_version","candidate_id","status","conflicts","preview_generation_allowed","explicit_accept_required","asset_mutation_authorized","project_mutation_authorized"],
  "properties":{
    "result_version":{"const":"0"},
    "candidate_id":{"type":"string","minLength":1},
    "status":{"enum":["READY_FOR_PREVIEW","BLOCKED"]},
    "conflicts":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["conflict_id","code","reason"],
      "properties":{
        "conflict_id":{"type":"string","minLength":1},
        "code":{"type":"string","minLength":1},
        "reason":{"type":"string","minLength":1},
        "track_id":{"type":"string","minLength":1},
        "clip_id":{"type":"string","minLength":1}
      }
    }},
    "preview_generation_allowed":{"type":"boolean"},
    "explicit_accept_required":{"const":true},
    "asset_mutation_authorized":{"const":false},
    "project_mutation_authorized":{"const":false}
  }
}
