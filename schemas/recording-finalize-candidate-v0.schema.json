{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/recording-finalize-candidate-v0.schema.json",
  "title":"MUSICA Recording Finalize Candidate v0",
  "type":"object",
  "additionalProperties":false,
  "required":["candidate_version","candidate_id","authority_target","source","capture","destination","actor","reason","preview_only"],
  "properties":{
    "candidate_version":{"const":"0"},
    "candidate_id":{"$ref":"#/$defs/stableId"},
    "authority_target":{"const":"recording_finalize_to_audio_material"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["project_id","revision_id","blueprint_sha256","audio_material_sha256","routing_material_sha256","automation_material_sha256"],
      "properties":{
        "project_id":{"type":"string","minLength":1,"maxLength":128},
        "revision_id":{"type":"string","minLength":1,"maxLength":128},
        "blueprint_sha256":{"$ref":"#/$defs/sha256"},
        "audio_material_sha256":{"$ref":"#/$defs/sha256"},
        "routing_material_sha256":{"$ref":"#/$defs/sha256"},
        "automation_material_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "capture":{
      "type":"object","additionalProperties":false,
      "required":["recording_capture_plan_sha256","recording_capture_run_report_sha256","payload_sha256","payload_size_bytes","sample_rate_hz","channels","captured_frames","sample_format"],
      "properties":{
        "recording_capture_plan_sha256":{"$ref":"#/$defs/sha256"},
        "recording_capture_run_report_sha256":{"$ref":"#/$defs/sha256"},
        "payload_sha256":{"$ref":"#/$defs/sha256"},
        "payload_size_bytes":{"type":"integer","minimum":1},
        "sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},
        "channels":{"enum":[1,2]},
        "captured_frames":{"type":"integer","minimum":1},
        "sample_format":{"const":"pcm16_little_endian"}
      }
    },
    "destination":{
      "type":"object","additionalProperties":false,
      "required":["track_id","clip_id","timeline_start_seconds","gain_db"],
      "properties":{
        "track_id":{"$ref":"#/$defs/stableId"},
        "clip_id":{"$ref":"#/$defs/stableId"},
        "timeline_start_seconds":{"type":"number","minimum":0},
        "gain_db":{"type":"number","minimum":-60.0,"maximum":12.0}
      }
    },
    "actor":{
      "type":"object","additionalProperties":false,
      "required":["kind","actor_id"],
      "properties":{
        "kind":{"enum":["user","ai","system"]},
        "actor_id":{"$ref":"#/$defs/stableId"}
      }
    },
    "reason":{"type":"string","minLength":1,"maxLength":1000},
    "preview_only":{"const":true}
  },
  "$defs":{
    "stableId":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
