{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/renderer-request-v0.schema.json",
  "title": "MUSICA RendererRequest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "request_id", "music_ir_sha256", "renderer_id", "outputs", "seed", "audio", "hints"],
  "properties": {
    "request_version": {"const": "0"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "music_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "renderer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["midi", "wav"]}
    },
    "seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate", "channels", "sample_width_bytes", "duration_seconds"],
      "properties": {
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000},
        "channels": {"type": "integer", "enum": [1, 2]},
        "sample_width_bytes": {"type": "integer", "enum": [1, 2, 3, 4]},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
      }
    },
    "hints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_preferences"],
      "properties": {
        "quality_preferences": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
