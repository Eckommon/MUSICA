{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/routing-authority-result-v0.schema.json",
  "title": "MUSICA Routing Authority Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version","candidate_id","status","conflicts","preview_generation_allowed","explicit_accept_required","project_mutation_authorized","render_mutation_authorized"],
  "properties": {
    "result_version":{"const":"0"},
    "candidate_id":{"type":"string","minLength":1,"maxLength":128},
    "status":{"enum":["READY_FOR_PREVIEW","BLOCKED"]},
    "conflicts":{
      "type":"array","maxItems":1024,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["conflict_id","code","reason"],
        "properties":{
          "conflict_id":{"type":"string","minLength":1,"maxLength":128},
          "code":{"enum":["STALE_SOURCE","UNKNOWN_TRACK","UNKNOWN_NODE","UNKNOWN_SEND","INVALID_GRAPH","INVALID_VALUE","HARD_LOCK_VIOLATION","CONSTRAINT_VIOLATION","UNREPRESENTABLE_EDIT"]},
          "track_id":{"type":["string","null"],"minLength":1,"maxLength":128},
          "node_id":{"type":["string","null"],"minLength":1,"maxLength":128},
          "send_id":{"type":["string","null"],"minLength":1,"maxLength":128},
          "rule_id":{"type":["string","null"],"minLength":1,"maxLength":128},
          "reason":{"type":"string","minLength":1,"maxLength":1000}
        }
      }
    },
    "preview_generation_allowed":{"type":"boolean"},
    "explicit_accept_required":{"const":true},
    "project_mutation_authorized":{"const":false},
    "render_mutation_authorized":{"const":false}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"READY_FOR_PREVIEW"}}},"then":{"properties":{"conflicts":{"maxItems":0},"preview_generation_allowed":{"const":true}}}},
    {"if":{"properties":{"status":{"const":"BLOCKED"}}},"then":{"properties":{"conflicts":{"minItems":1},"preview_generation_allowed":{"const":false}}}}
  ]
}
