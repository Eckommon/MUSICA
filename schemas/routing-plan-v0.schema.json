{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eckommon.github.io/MUSICA/schemas/routing-plan-v0.schema.json",
  "title": "MUSICA Routing Plan v0",
  "description": "Derived/non-canonical deterministic signal-flow plan lowered from routing material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "classification",
    "source",
    "policy",
    "nodes",
    "track_outputs",
    "sends",
    "master_node_id",
    "routing_plan_sha256"
  ],
  "properties": {
    "plan_version": {"const": "0"},
    "classification": {"const": "derived_noncanonical"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing_material_sha256", "track_ids"],
      "properties": {
        "routing_material_sha256": {"$ref": "#/$defs/sha256"},
        "track_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_policy", "send_tap", "node_ordering", "master_policy"],
      "properties": {
        "graph_policy": {"const": "acyclic_fail_closed"},
        "send_tap": {"const": "post_fader"},
        "node_ordering": {"const": "topological_then_order_node_id"},
        "master_policy": {"const": "exactly_one_sink_when_nonempty"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/planNode"}
    },
    "track_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/trackOutput"}
    },
    "sends": {
      "type": "array",
      "items": {"$ref": "#/$defs/send"}
    },
    "master_node_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "routing_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "gainDb": {"type": "number", "minimum": -60.0, "maximum": 12.0},
    "mixer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gain_db", "pan", "mute"],
      "properties": {
        "gain_db": {"$ref": "#/$defs/gainDb"},
        "pan": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "mute": {"type": "boolean"}
      }
    },
    "planNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "order",
        "topological_index",
        "name",
        "node_type",
        "mixer",
        "output_node_id"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/stableId"},
        "order": {"type": "integer", "minimum": 0},
        "topological_index": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "node_type": {"enum": ["bus", "group", "return", "master"]},
        "mixer": {"$ref": "#/$defs/mixer"},
        "output_node_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "trackOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "target_node_id"],
      "properties": {
        "track_id": {"$ref": "#/$defs/stableId"},
        "target_node_id": {"$ref": "#/$defs/stableId"}
      }
    },
    "send": {
      "type": "object",
      "additionalProperties": false,
      "required": ["send_id", "source_kind", "source_id", "target_node_id", "gain_db", "tap"],
      "properties": {
        "send_id": {"$ref": "#/$defs/stableId"},
        "source_kind": {"enum": ["track", "node"]},
        "source_id": {"$ref": "#/$defs/stableId"},
        "target_node_id": {"$ref": "#/$defs/stableId"},
        "gain_db": {"$ref": "#/$defs/gainDb"},
        "tap": {"const": "post_fader"}
      }
    }
  }
}
