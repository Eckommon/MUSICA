{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eckommon.github.io/MUSICA/schemas/studio-realtime-runtime-view-v0.schema.json",
  "title":"MUSICA Studio Realtime Runtime Inspection View v0",
  "type":"object",
  "additionalProperties":false,
  "required":["view_version","runtime_id","studio_session_id","project_id","revision_id","branch","source","realtime_execution_plan_sha256","backend","configuration","transport","latency","metrics","authority"],
  "properties":{
    "view_version":{"const":"0"},
    "runtime_id":{"type":"string","minLength":1,"maxLength":128},
    "studio_session_id":{"type":"string","minLength":1,"maxLength":128},
    "project_id":{"type":"string","minLength":1},
    "revision_id":{"type":"string","minLength":1},
    "branch":{"type":"string","minLength":1},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["blueprint_sha256","audio_material_sha256","routing_material_sha256","automation_material_sha256","routed_mix_plan_sha256","routed_wav_sha256"],
      "properties":{
        "blueprint_sha256":{"$ref":"#/$defs/sha256"},
        "audio_material_sha256":{"$ref":"#/$defs/sha256"},
        "routing_material_sha256":{"$ref":"#/$defs/sha256"},
        "automation_material_sha256":{"$ref":"#/$defs/sha256"},
        "routed_mix_plan_sha256":{"$ref":"#/$defs/sha256"},
        "routed_wav_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "realtime_execution_plan_sha256":{"$ref":"#/$defs/sha256"},
    "backend":{
      "type":"object","additionalProperties":false,
      "required":["backend_id","classification","capability_sha256"],
      "properties":{
        "backend_id":{"type":"string","minLength":1},
        "classification":{"const":"simulated_test_backend"},
        "capability_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "configuration":{
      "type":"object","additionalProperties":false,
      "required":["sample_rate_hz","output_channels","block_size_frames","duration_frames"],
      "properties":{
        "sample_rate_hz":{"type":"integer","minimum":8000,"maximum":192000},
        "output_channels":{"type":"integer","minimum":1,"maximum":32},
        "block_size_frames":{"type":"integer","minimum":1},
        "duration_frames":{"type":"integer","minimum":1}
      }
    },
    "transport":{
      "type":"object","additionalProperties":false,
      "required":["transport_id","state","playhead_frame","callback_index"],
      "properties":{
        "transport_id":{"const":"musica-exact-frame-transport-v0"},
        "state":{"enum":["STOPPED","PLAYING","END_OF_STREAM"]},
        "playhead_frame":{"type":"integer","minimum":0},
        "callback_index":{"type":["integer","null"],"minimum":0}
      }
    },
    "latency":{
      "type":"object","additionalProperties":false,
      "required":["configured_block_size_frames","nominal_output_latency_frames","nominal_source","host_observed_latency_available","wall_clock_guarantee_claimed"],
      "properties":{
        "configured_block_size_frames":{"type":"integer","minimum":1},
        "nominal_output_latency_frames":{"type":"integer","minimum":0},
        "nominal_source":{"const":"simulated_backend_capability"},
        "host_observed_latency_available":{"const":false},
        "wall_clock_guarantee_claimed":{"const":false}
      }
    },
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["play_count","stop_count","seek_count","transport_discontinuity_count","callbacks_requested","frames_requested","frames_delivered","error_count","short_fill_count","late_count","xrun_dropout_equivalent_count"],
      "properties":{
        "play_count":{"type":"integer","minimum":0},
        "stop_count":{"type":"integer","minimum":0},
        "seek_count":{"type":"integer","minimum":0},
        "transport_discontinuity_count":{"type":"integer","minimum":0},
        "callbacks_requested":{"type":"integer","minimum":0},
        "frames_requested":{"type":"integer","minimum":0},
        "frames_delivered":{"type":"integer","minimum":0},
        "error_count":{"type":"integer","minimum":0},
        "short_fill_count":{"type":"integer","minimum":0},
        "late_count":{"type":"integer","minimum":0},
        "xrun_dropout_equivalent_count":{"type":"integer","minimum":0}
      }
    },
    "authority":{
      "type":"object","additionalProperties":false,
      "required":["accepted_project_state_is_canonical","runtime_state_is_canonical","browser_state_is_canonical","project_mutation_authorized","runtime_commands_mutate_project","position_authority"],
      "properties":{
        "accepted_project_state_is_canonical":{"const":true},
        "runtime_state_is_canonical":{"const":false},
        "browser_state_is_canonical":{"const":false},
        "project_mutation_authorized":{"const":false},
        "runtime_commands_mutate_project":{"const":false},
        "position_authority":{"const":"exact_frame_cursor_not_wall_clock"}
      }
    }
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
